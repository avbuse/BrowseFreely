# BrowseFreely Environment Configuration

# The port the server will run on (Default: 3000)
PORT=3000

# The environment mode (development/production)
NODE_ENV=development

# Max requests per minute per IP address (Default: 100)
RATE_LIMIT=100

# Secret used to derive the AES-256-GCM key for the in-memory cookie jar.
# Use a long random string (32+ chars). If unset, an ephemeral key is generated
# at process start (sessions will not survive restarts).
SESSION_SECRET=change-me-to-a-long-random-string

# Bind encrypted jars to bf_session cookie + client IP (always on in this build).
# Cookies are stored under hash(sessionId|ip) so stolen session cookies are useless
# from a different address.

# Force Secure cookie flag (default: auto — Secure only on HTTPS).
# On plain HTTP LAN hosts, leave unset or set false so browsers accept bf_session.
# SECURE_COOKIES=false

# Trust X-Forwarded-For / CF-Connecting-IP (default: false).
# Enable only behind a trusted reverse proxy.
# TRUST_PROXY=false

# Allow proxying private/LAN targets (default: false — SSRF protection on).
# ALLOW_PRIVATE_TARGETS=false

# Disable TLS certificate verification for upstream fetches (default: false).
# Only for broken MITM middleboxes or self-signed LAN HTTPS.
# INSECURE_TLS=false

# Optional: path for broken-site report log (default: ./data/broken-sites.jsonl)
# REPORTS_PATH=/app/data/broken-sites.jsonl

# Optional: Upstream proxy to route all BrowseFreely fetch requests through
# Useful for bypassing Cloudflare or region blocks on the server itself
# (not implemented yet)
# UPSTREAM_PROXY=socks5://username:password@proxy-host:1080
